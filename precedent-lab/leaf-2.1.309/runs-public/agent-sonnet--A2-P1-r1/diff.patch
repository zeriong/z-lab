+test("close renumbers keys", () => {
+  const s = openAll(["a", "b", "c"]);
+  assert.equal(toQuery(closeTab(s, "t2")), "t1,t2");
+});
+
+test("close renumbers a middle tab and keeps order", () => {
+  const s = closeTab(openAll(["a", "b", "c", "d"]), "t2");
+  assert.deepEqual(s.tabs, [
+    { key: "t1", title: "a" },
+    { key: "t2", title: "c" },
+    { key: "t3", title: "d" },
+  ]);
+  assert.equal(toQuery(s), "t1,t2,t3");
+});
+
+test("close first and last tabs renumbers from t1", () => {
+  const s = openAll(["a", "b", "c"]);
+  assert.equal(toQuery(closeTab(s, "t1")), "t1,t2");
+  assert.deepEqual(closeTab(s, "t1").tabs.map((tab) => tab.title), ["b", "c"]);
+  assert.equal(toQuery(closeTab(s, "t3")), "t1,t2");
+  assert.deepEqual(closeTab(s, "t3").tabs.map((tab) => tab.title), ["a", "b"]);
+});
+
+test("close of the only tab empties the strip and restarts at t1", () => {
+  const s = closeTab(openAll(["a"]), "t1");
+  assert.equal(toQuery(s), "");
+  assert.equal(toQuery(openTab(s, "b")), "t1");
+});
+
+test("close of an unknown key changes nothing", () => {
+  const s = openAll(["a", "b"]);
+  assert.deepEqual(closeTab(s, "t9"), s);
+});
+
+test("next open after close continues from the remaining count", () => {
+  const s = closeTab(openAll(["a", "b", "c"]), "t2");
+  const opened = openTab(s, "d");
+  assert.equal(toQuery(opened), "t1,t2,t3");
+  assert.deepEqual(opened.tabs.at(-1), { key: "t3", title: "d" });
+});
+
+test("repeated closes and opens never leave gaps or duplicate keys", () => {
+  let s = openAll(["a", "b", "c", "d"]);
+  s = closeTab(s, "t1");
+  s = openTab(s, "e");
+  s = closeTab(s, "t2");
+  s = openTab(s, "f");
+  assert.equal(toQuery(s), "t1,t2,t3,t4");
+  assert.deepEqual(s.tabs.map((tab) => tab.title), ["b", "d", "e", "f"]);
 });
