+/**
+ * @param {{ next: number, tabs: Array<{ key: string, title: string }> }} state Tab state to update.
+ * @param {string} key Stable key of the tab to close.
+ * @returns {{ next: number, tabs: Array<{ key: string, title: string }> }} A new state with the matching tab removed.
+ */
 export function closeTab(state, key) {
   return { ...state, tabs: state.tabs.filter((tab) => tab.key !== key) };
 }
