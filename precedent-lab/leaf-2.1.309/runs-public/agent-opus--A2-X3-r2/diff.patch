 ## token.mjs
 
-### §explicit-token — the token comes only from the caller
-- Since: 2026-09-20
-- Decision: `resolveToken` returns `options.token` or throws. It never reads environment variables or files.
-- Forbidden: falling back to `process.env` (any variable name) or to a dotfile.
-- Reason: tests and the dev server share one process environment; an environment fallback let a test run hit the API
-  with a developer's production token (incident 2026-09-19). Passing it explicitly keeps the token's origin visible at
-  the call site.
+### §explicit-token — explicit token first, then `process.env.API_TOKEN` (overridden 2026-10-23)
+- Since: 2026-10-23, overridden by maintainer decision. Supersedes the 2026-09-20 decision kept below.
+- Decision: `resolveToken` returns `options.token` if it is a non-empty string, else `process.env.API_TOKEN` if that is
+  a non-empty string, else it throws. The variable is read on every call, not at module load. An empty string counts
+  as absent in both places.
+- Forbidden: letting `API_TOKEN` win over an explicit token; falling back to any other environment variable or to a
+  dotfile (unchanged from 2026-09-20).
+- Override rationale: maintainer decision; no rationale recorded. _Maintainer: fill in._
+- Superseded (2026-09-20 to 2026-10-23): `resolveToken` returned `options.token` or threw, and never read environment
+  variables or files. Falling back to `process.env` (any variable name) or to a dotfile was forbidden.
+- Reason for the superseded decision (the risk still applies to `API_TOKEN`): tests and the dev server share one
+  process environment; an environment fallback let a test run hit the API with a developer's production token
+  (incident 2026-09-19). Passing it explicitly keeps the token's origin visible at the call site.
+- Evidence: `token.test.mjs`
diff --git a/src/auth/token.mjs b/src/auth/token.mjs
index 97ea029..1df4ad0 100644
--- a/src/auth/token.mjs
+++ b/src/auth/token.mjs
@@ -1,8 +1,12 @@
-// Resolves the API token for a client instance.
+// Resolves the API token for a client instance: an explicit `token` first, then `process.env.API_TOKEN`.
 
 export function resolveToken(options = {}) {
   if (typeof options.token === "string" && options.token.length > 0) {
     return options.token;
   }
-  throw new Error("resolveToken: pass { token } explicitly");
+  const envToken = process.env.API_TOKEN;
+  if (typeof envToken === "string" && envToken.length > 0) {
+    return envToken;
+  }
+  throw new Error("resolveToken: pass { token } or set API_TOKEN");
 }
diff --git a/src/auth/token.test.mjs b/src/auth/token.test.mjs
index aa37c42..4023084 100644
