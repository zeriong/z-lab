--- a/src/tabs/tab-keys.mjs
+++ b/src/tabs/tab-keys.mjs
@@ -10,7 +10,11 @@ export function openTab(state, title) {
 }
 
 export function closeTab(state, key) {
-  return { ...state, tabs: state.tabs.filter((tab) => tab.key !== key) };
+  const remaining = state.tabs.filter((tab) => tab.key !== key);
+  if (remaining.length === state.tabs.length) return state;
+
+  const tabs = remaining.map((tab, index) => ({ ...tab, key: `t${index + 1}` }));
+  return { next: tabs.length + 1, tabs };
 }
 
 export function toQuery(state) {
