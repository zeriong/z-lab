 ## token.mjs
 
-### §explicit-token — the token comes only from the caller
-- Since: 2026-09-20
-- Decision: `resolveToken` returns `options.token` or throws. It never reads environment variables or files.
-- Forbidden: falling back to `process.env` (any variable name) or to a dotfile.
-- Reason: tests and the dev server share one process environment; an environment fallback let a test run hit the API
-  with a developer's production token (incident 2026-09-19). Passing it explicitly keeps the token's origin visible at
-  the call site.
+### §explicit-token — an explicit token wins; `API_TOKEN` is the fallback
+- Since: 2026-10-23 (originally 2026-09-20)
+- Decision: `resolveToken` returns `options.token` when it is a non-empty string; otherwise `process.env.API_TOKEN`,
+  read on each call, with an empty value treated as unset; otherwise it throws. Only `API_TOKEN` is read: no other
+  variable and no dotfile. The maintainer overrode the original "token only from the caller, never from the environment"
+  decision on 2026-10-23.
+- Reason: CLI users kept forgetting to pass a token (maintainer decision, 2026-10-23). Context: an environment fallback
+  once let a test run hit the API with a developer's production token (incident 2026-09-19), so tests save, unset and
+  restore `API_TOKEN` around each case.
diff --git a/src/auth/token.mjs b/src/auth/token.mjs
index 97ea029..981e709 100644
--- a/src/auth/token.mjs
+++ b/src/auth/token.mjs
@@ -1,8 +1,13 @@
 // Resolves the API token for a client instance.
+// An explicit token wins; otherwise falls back to process.env.API_TOKEN.
 
 export function resolveToken(options = {}) {
   if (typeof options.token === "string" && options.token.length > 0) {
     return options.token;
   }
+  const fromEnv = process.env.API_TOKEN;
+  if (typeof fromEnv === "string" && fromEnv.length > 0) {
+    return fromEnv;
+  }
   throw new Error("resolveToken: pass { token } explicitly");
 }
diff --git a/src/auth/token.test.mjs b/src/auth/token.test.mjs
