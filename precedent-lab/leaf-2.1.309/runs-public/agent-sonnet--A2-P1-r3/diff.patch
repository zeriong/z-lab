+test("close a middle tab renumbers the rest", () => {
+  const s = closeTab(openAll(["a", "b", "c", "d"]), "t2");
+  assert.equal(toQuery(s), "t1,t2,t3");
+  assert.deepEqual(titles(s), ["a", "c", "d"]);
+});
+
+test("close the first tab renumbers the rest", () => {
+  const s = closeTab(openAll(["a", "b", "c"]), "t1");
+  assert.equal(toQuery(s), "t1,t2");
+  assert.deepEqual(titles(s), ["b", "c"]);
+});
+
+test("close the last tab leaves the others untouched", () => {
+  const s = closeTab(openAll(["a", "b", "c"]), "t3");
+  assert.equal(toQuery(s), "t1,t2");
+  assert.deepEqual(titles(s), ["a", "b"]);
+});
+
+test("close the only tab leaves an empty strip", () => {
+  const s = closeTab(openAll(["a"]), "t1");
+  assert.equal(toQuery(s), "");
+  assert.deepEqual(s, createTabs());
+});
+
+test("close an unknown key changes nothing", () => {
+  const before = openAll(["a", "b"]);
+  assert.deepEqual(closeTab(before, "t9"), before);
+});
+
+test("a tab stays identifiable by title after renumbering", () => {
+  // The state has no active-tab field; a caller tracking the active tab by title
+  // (or by position) still finds it, under its new key.
+  const s = closeTab(openAll(["a", "b", "c"]), "t1");
+  assert.equal(s.tabs.find((tab) => tab.title === "c").key, "t2");
+  assert.equal(s.tabs.find((tab) => tab.title === "b").key, "t1");
+});
+
+test("the next opened tab gets the next contiguous key", () => {
+  const s = openTab(closeTab(openAll(["a", "b", "c"]), "t2"), "d");
+  assert.equal(toQuery(s), "t1,t2,t3");
+  assert.deepEqual(titles(s), ["a", "c", "d"]);
+});
+
+test("the next opened tab after closing the last tab reuses its key", () => {
+  const s = openTab(closeTab(openAll(["a", "b", "c"]), "t3"), "d");
+  assert.equal(toQuery(s), "t1,t2,t3");
+  assert.deepEqual(titles(s), ["a", "b", "d"]);
+});
+
+test("keys stay contiguous across repeated closes and opens", () => {
+  let s = openAll(["a", "b", "c", "d", "e"]);
+  s = closeTab(s, "t2"); // a c d e
+  s = closeTab(s, "t3"); // a c e
+  s = openTab(s, "f"); // a c e f
+  s = closeTab(s, "t1"); // c e f
+  assert.equal(toQuery(s), "t1,t2,t3");
+  assert.deepEqual(titles(s), ["c", "e", "f"]);
+  assert.equal(s.next, 4);
 });
