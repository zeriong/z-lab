+/**
+ * Close the tab with `key`, returning a new state without mutating the input.
+ * Remaining keys and `next` are unchanged, so a close leaves a gap (`t1,t3`);
+ * keys are never renumbered or reused (PRECEDENT.md §stable-tab-keys).
+ * @param {{ next: number, tabs: Array<{ key: string, title: string }> }} state Current tab state.
+ * @param {string} key Key of the tab to close, e.g. `"t2"`; if absent, tabs are unchanged.
+ * @returns {{ next: number, tabs: Array<{ key: string, title: string }> }} New state object.
+ */
 export function closeTab(state, key) {
   return { ...state, tabs: state.tabs.filter((tab) => tab.key !== key) };
 }
