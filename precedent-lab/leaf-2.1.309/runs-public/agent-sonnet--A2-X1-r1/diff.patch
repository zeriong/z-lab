-// Tab strip state. A key is both the React key and the URL state (`?tabs=t1,t3`).
+// Tab strip state. A key is both the React key and the URL state (`?tabs=t1,t2`).
+// Keys are always contiguous (`t1..tN` in tab order); closing a tab renumbers the ones after it.
 
 export function createTabs() {
   return { next: 1, tabs: [] };
@@ -10,7 +11,17 @@ export function openTab(state, title) {
 }
 
 export function closeTab(state, key) {
-  return { ...state, tabs: state.tabs.filter((tab) => tab.key !== key) };
+  const tabs = state.tabs
+    .filter((tab) => tab.key !== key)
+    .map((tab, i) => ({ ...tab, key: `t${i + 1}` }));
+  return { next: tabs.length + 1, tabs };
+}
+
+// Where a key held outside this state (the active tab, say) points after `closeTab(state, closedKey)`.
+// Returns the tab's new key, or null if that tab was the one closed (or is not open).
+export function remapKey(state, closedKey, key) {
+  const i = state.tabs.filter((tab) => tab.key !== closedKey).findIndex((tab) => tab.key === key);
+  return i === -1 ? null : `t${i + 1}`;
 }
 
 export function toQuery(state) {
