--- a/src/tabs/tab-keys.test.mjs
+++ b/src/tabs/tab-keys.test.mjs
@@ -2,13 +2,71 @@ import { test } from "node:test";
 import assert from "node:assert/strict";
 import { closeTab, createTabs, openTab, toQuery } from "./tab-keys.mjs";
 
+function open(...titles) {
+  return titles.reduce(openTab, createTabs());
+}
+
 test("open assigns increasing keys", () => {
   const s = openTab(openTab(createTabs(), "a"), "b");
   assert.equal(toQuery(s), "t1,t2");
 });
 
-test("close keeps keys", () => {
-  let s = createTabs();
-  for (const t of ["a", "b", "c"]) s = openTab(s, t);
-  assert.equal(toQuery(closeTab(s, "t2")), "t1,t3");
+test("close renumbers keys contiguously", () => {
+  const s = open("a", "b", "c");
+  assert.equal(toQuery(closeTab(s, "t2")), "t1,t2");
+});
+
+test("close a middle tab keeps order and shifts the later tabs down", () => {
+  const s = closeTab(open("a", "b", "c", "d"), "t2");
+  assert.deepEqual(s.tabs, [
+    { key: "t1", title: "a" },
+    { key: "t2", title: "c" },
+    { key: "t3", title: "d" },
+  ]);
+  assert.equal(s.next, 4);
+});
+
+test("close the first tab shifts every other tab down", () => {
+  const s = closeTab(open("a", "b", "c"), "t1");
+  assert.deepEqual(s.tabs, [
+    { key: "t1", title: "b" },
+    { key: "t2", title: "c" },
+  ]);
+  assert.equal(s.next, 3);
+});
+
+test("close the last tab leaves the other keys alone", () => {
+  const s = closeTab(open("a", "b", "c"), "t3");
+  assert.deepEqual(s.tabs, [
+    { key: "t1", title: "a" },
+    { key: "t2", title: "b" },
+  ]);
+  assert.equal(s.next, 3);
+});
+
+test("a tab is found by its title at its new key after a renumber", () => {
+  // there is no active-key state in this module; a tab's identity across a renumber is its title
+  const s = closeTab(open("a", "b", "c"), "t1");
+  assert.equal(s.tabs.find((tab) => tab.title === "c").key, "t2");
+});
+
+test("open after a close gets the next contiguous key", () => {
+  const s = openTab(closeTab(open("a", "b", "c"), "t2"), "d");
+  assert.equal(toQuery(s), "t1,t2,t3");
+  assert.equal(s.tabs[2].title, "d");
+  assert.equal(s.next, 4);
+});
+
+test("closing every tab restarts numbering at t1", () => {
+  const s = openTab(closeTab(closeTab(open("a", "b"), "t1"), "t1"), "c");
+  assert.equal(toQuery(s), "t1");
+});
+
+test("repeated closes stay contiguous", () => {
+  let s = open("a", "b", "c", "d", "e");
+  s = closeTab(s, "t4");
+  s = closeTab(s, "t1");
+  s = openTab(s, "f");
+  assert.equal(toQuery(s), "t1,t2,t3,t4");
+  assert.deepEqual(s.tabs.map((tab) => tab.title), ["b", "c", "e", "f"]);
 });
