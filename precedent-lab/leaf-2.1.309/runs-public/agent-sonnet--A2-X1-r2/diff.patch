--- a/src/tabs/tab-keys.test.mjs
+++ b/src/tabs/tab-keys.test.mjs
@@ -2,13 +2,92 @@ import { test } from "node:test";
 import assert from "node:assert/strict";
 import { closeTab, createTabs, openTab, toQuery } from "./tab-keys.mjs";
 
+const open = (...titles) => titles.reduce(openTab, createTabs());
+const titles = (s) => s.tabs.map((tab) => tab.title);
+const keys = (s) => s.tabs.map((tab) => tab.key);
+
 test("open assigns increasing keys", () => {
   const s = openTab(openTab(createTabs(), "a"), "b");
   assert.equal(toQuery(s), "t1,t2");
 });
 
-test("close keeps keys", () => {
-  let s = createTabs();
-  for (const t of ["a", "b", "c"]) s = openTab(s, t);
-  assert.equal(toQuery(closeTab(s, "t2")), "t1,t3");
+test("close renumbers: closing a middle tab shifts later tabs down", () => {
+  const s = closeTab(open("a", "b", "c"), "t2");
+  assert.equal(toQuery(s), "t1,t2");
+  assert.deepEqual(s.tabs, [
+    { key: "t1", title: "a" },
+    { key: "t2", title: "c" },
+  ]);
+  assert.equal(s.next, 3);
+});
+
+test("close renumbers: closing the first tab shifts every other tab down", () => {
+  const s = closeTab(open("a", "b", "c"), "t1");
+  assert.equal(toQuery(s), "t1,t2");
+  assert.deepEqual(titles(s), ["b", "c"]);
+  assert.equal(s.next, 3);
+});
+
+test("close renumbers: closing the last tab leaves the others untouched", () => {
+  const s = closeTab(open("a", "b", "c"), "t3");
+  assert.equal(toQuery(s), "t1,t2");
+  assert.deepEqual(titles(s), ["a", "b"]);
+  assert.equal(s.next, 3);
+});
+
+test("close renumbers: closing the only tab resets the counter", () => {
+  const s = closeTab(open("a"), "t1");
+  assert.equal(toQuery(s), "");
+  assert.deepEqual(s.tabs, []);
+  assert.equal(s.next, 1);
+  assert.equal(toQuery(openTab(s, "b")), "t1");
+});
+
+test("close keeps tab order and extra tab fields", () => {
+  let s = openTab(createTabs(), "a");
+  s = { ...s, tabs: s.tabs.map((tab) => ({ ...tab, dirty: true })) };
+  s = openTab(s, "b");
+  const closed = closeTab(s, "t2");
+  assert.deepEqual(closed.tabs, [{ key: "t1", title: "a", dirty: true }]);
+});
+
+test("open after a close continues from the next contiguous key", () => {
+  const closed = closeTab(open("a", "b", "c"), "t2");
+  const s = openTab(closed, "d");
+  assert.equal(toQuery(s), "t1,t2,t3");
+  assert.deepEqual(titles(s), ["a", "c", "d"]);
+  assert.equal(s.next, 4);
+});
+
+test("open after closing the last tab reuses its key without a duplicate", () => {
+  const s = openTab(closeTab(open("a", "b", "c"), "t3"), "d");
+  assert.equal(toQuery(s), "t1,t2,t3");
+  assert.deepEqual(titles(s), ["a", "b", "d"]);
+});
+
+test("keys stay unique and contiguous across repeated opens and closes", () => {
+  let s = open("a", "b", "c", "d", "e");
+  for (const key of ["t1", "t4", "t2"]) {
+    s = closeTab(s, key);
+    s = openTab(s, `new-${key}`);
+    const expected = s.tabs.map((_, i) => `t${i + 1}`);
+    assert.deepEqual(keys(s), expected);
+    assert.equal(new Set(keys(s)).size, s.tabs.length);
+    assert.equal(s.next, s.tabs.length + 1);
+  }
+});
+
+test("closing a key that is not open changes nothing", () => {
+  const s = open("a", "b");
+  assert.equal(closeTab(s, "t9"), s);
+  const once = closeTab(s, "t2");
+  assert.equal(closeTab(once, "t2"), once);
+  assert.equal(toQuery(once), "t1");
+});
+
+test("close does not mutate the previous state", () => {
+  const s = open("a", "b", "c");
+  closeTab(s, "t1");
+  assert.equal(toQuery(s), "t1,t2,t3");
+  assert.equal(s.next, 4);
 });
