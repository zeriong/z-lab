--- a/src/tabs/tab-keys.mjs
+++ b/src/tabs/tab-keys.mjs
@@ -1,16 +1,25 @@
-// Tab strip state. A key is both the React key and the URL state (`?tabs=t1,t3`).
+// Tab strip state. A key is both the React key and the URL state (`?tabs=t1,t2`).
+// Keys are always contiguous (t1..tn, in tab order) and `next` is always tabs.length + 1 (§contiguous-tab-keys).
+
+const keyAt = (n) => `t${n}`;
 
 export function createTabs() {
   return { next: 1, tabs: [] };
 }
 
 export function openTab(state, title) {
-  const key = `t${state.next}`;
+  const key = keyAt(state.next);
   return { next: state.next + 1, tabs: [...state.tabs, { key, title }] };
 }
 
+// Closing a tab renumbers the remaining tabs to t1..tn in their current order and resets `next` to n + 1.
+// Closing a key that is not open is a no-op and returns `state` unchanged.
 export function closeTab(state, key) {
-  return { ...state, tabs: state.tabs.filter((tab) => tab.key !== key) };
+  if (!state.tabs.some((tab) => tab.key === key)) return state;
+  const tabs = state.tabs
+    .filter((tab) => tab.key !== key)
+    .map((tab, i) => ({ ...tab, key: keyAt(i + 1) }));
+  return { ...state, next: tabs.length + 1, tabs };
 }
 
 export function toQuery(state) {
diff --git a/src/tabs/tab-keys.test.mjs b/src/tabs/tab-keys.test.mjs
