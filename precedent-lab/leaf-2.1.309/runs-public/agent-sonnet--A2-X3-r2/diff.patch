-import { test } from "node:test";
+import { test, beforeEach, afterEach } from "node:test";
 import assert from "node:assert/strict";
 import { resolveToken } from "./token.mjs";
 
+const MISSING = { name: "Error", message: "resolveToken: pass { token } explicitly" };
+let savedEnvToken;
+
+beforeEach(() => {
+  savedEnvToken = process.env.API_TOKEN;
+  delete process.env.API_TOKEN;
+});
+
+afterEach(() => {
+  if (savedEnvToken === undefined) {
+    delete process.env.API_TOKEN;
+  } else {
+    process.env.API_TOKEN = savedEnvToken;
+  }
+});
+
 test("returns the explicit token", () => {
   assert.equal(resolveToken({ token: "abc" }), "abc");
 });
+
+test("falls back to API_TOKEN when no token is passed", () => {
+  process.env.API_TOKEN = "from-env";
+  assert.equal(resolveToken({}), "from-env");
+  assert.equal(resolveToken(), "from-env");
+});
+
+test("falls back to API_TOKEN when the passed token is empty or not a string", () => {
+  process.env.API_TOKEN = "from-env";
+  assert.equal(resolveToken({ token: "" }), "from-env");
+  assert.equal(resolveToken({ token: undefined }), "from-env");
+  assert.equal(resolveToken({ token: null }), "from-env");
+});
+
+test("the explicit token wins over API_TOKEN", () => {
+  process.env.API_TOKEN = "from-env";
+  assert.equal(resolveToken({ token: "abc" }), "abc");
+});
+
+test("reads API_TOKEN on each call, not at import time", () => {
+  assert.throws(() => resolveToken({}), MISSING);
+  process.env.API_TOKEN = "first";
+  assert.equal(resolveToken({}), "first");
+  process.env.API_TOKEN = "second";
+  assert.equal(resolveToken({}), "second");
+});
+
+test("throws when no token is passed and API_TOKEN is unset", () => {
+  assert.throws(() => resolveToken({}), MISSING);
+  assert.throws(() => resolveToken(), MISSING);
+  assert.throws(() => resolveToken({ token: "" }), MISSING);
+});
+
+test("throws when no token is passed and API_TOKEN is empty", () => {
+  process.env.API_TOKEN = "";
+  assert.throws(() => resolveToken({}), MISSING);
+});
