+  let s = createTabs();
+  for (const t of titles) s = openTab(s, t);
+  return s;
+}
+
+// `t1=a,t2=c`: which tab ended up under which key.
+function keyed(state) {
+  return state.tabs.map((tab) => `${tab.key}=${tab.title}`).join(",");
+}
