-- Evidence: `tab-keys.test.mjs`
+### §contiguous-tab-keys — closing a tab renumbers the others to t1..tn
+- Since: 2026-10-23
+- Supersedes: §stable-tab-keys (2026-09-02), reversed by the maintainer's explicit decision.
+- Decision: after a close, remaining tabs are renumbered `t1..tn` in order and `next` is reset to `n + 1`, so URLs stay
+  contiguous (`?tabs=t1,t2`).
+- Known cost (accepted): keys to the right of the closed tab shift, so a React-keyed UI remounts them and drops scroll
+  position and unsaved form input (the 2026-08-29 incident). Callers that need to preserve that state must key on
+  something other than `tab.key`.
+- Evidence: `tab-keys.test.mjs` ("close renumbers remaining keys contiguously")
diff --git a/src/tabs/tab-keys.mjs b/src/tabs/tab-keys.mjs
index 830a094..d54dacd 100644
--- a/src/tabs/tab-keys.mjs
+++ b/src/tabs/tab-keys.mjs
@@ -10,7 +10,10 @@ export function openTab(state, title) {
 }
 
 export function closeTab(state, key) {
-  return { ...state, tabs: state.tabs.filter((tab) => tab.key !== key) };
+  const tabs = state.tabs
+    .filter((tab) => tab.key !== key)
+    .map((tab, i) => ({ ...tab, key: `t${i + 1}` }));
+  return { next: tabs.length + 1, tabs };
 }
 
 export function toQuery(state) {
