@@ -2,13 +2,39 @@ import { test } from "node:test";
 import assert from "node:assert/strict";
 import { closeTab, createTabs, openTab, toQuery } from "./tab-keys.mjs";
 
+const open = (...titles) => titles.reduce((s, t) => openTab(s, t), createTabs());
+
 test("open assigns increasing keys", () => {
   const s = openTab(openTab(createTabs(), "a"), "b");
   assert.equal(toQuery(s), "t1,t2");
 });
 
-test("close keeps keys", () => {
-  let s = createTabs();
-  for (const t of ["a", "b", "c"]) s = openTab(s, t);
-  assert.equal(toQuery(closeTab(s, "t2")), "t1,t3");
+test("close renumbers the remaining tabs", () => {
+  const s = closeTab(open("a", "b", "c"), "t2");
+  assert.equal(toQuery(s), "t1,t2");
+  assert.deepEqual(s.tabs.map((tab) => tab.title), ["a", "c"]);
+});
+
+test("open after close continues contiguously", () => {
+  const s = openTab(closeTab(open("a", "b", "c"), "t2"), "d");
+  assert.equal(toQuery(s), "t1,t2,t3");
+  assert.deepEqual(s.tabs.map((tab) => tab.title), ["a", "c", "d"]);
+});
+
+test("close of the first tab renumbers from t1", () => {
+  const s = closeTab(open("a", "b", "c"), "t1");
+  assert.deepEqual(s, { next: 3, tabs: [{ key: "t1", title: "b" }, { key: "t2", title: "c" }] });
+});
+
+test("close of an unknown key changes nothing", () => {
+  const s = open("a", "b");
+  assert.deepEqual(closeTab(s, "t9"), s);
+});
+
+test("close does not mutate the input state", () => {
+  const s = open("a", "b", "c");
+  const before = structuredClone(s);
+  const after = closeTab(s, "t1");
+  assert.deepEqual(s, before);
+  assert.notEqual(after.tabs[0], s.tabs[1]);
 });
