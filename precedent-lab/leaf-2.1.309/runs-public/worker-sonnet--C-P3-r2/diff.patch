 ## token.mjs
 
-### §explicit-token — the token comes only from the caller
+### §env-token-fallback — explicit token first, then `API_TOKEN`
+- Since: 2026-10-23
+- Supersedes: §explicit-token (2026-09-20)
+- Decision: `resolveToken` returns `options.token` when given, otherwise `process.env.API_TOKEN`, otherwise throws. No
+  other environment variable and no dotfile is read.
+- Reason: CLI users kept forgetting to pass the token. Maintainer decision.
+- Risk carried over from the superseded record: tests and the dev server share one process environment, and an
+  environment fallback once let a test run hit the API with a developer's production token (incident 2026-09-19).
+  Tests that call `resolveToken` must clear `API_TOKEN` first (see `token.test.mjs`).
+
+### §explicit-token — the token comes only from the caller (SUPERSEDED by §env-token-fallback)
 - Since: 2026-09-20
 - Decision: `resolveToken` returns `options.token` or throws. It never reads environment variables or files.
 - Forbidden: falling back to `process.env` (any variable name) or to a dotfile.
 - Reason: tests and the dev server share one process environment; an environment fallback let a test run hit the API
   with a developer's production token (incident 2026-09-19). Passing it explicitly keeps the token's origin visible at
   the call site.
+
+## token.test.mjs
+
+### §clear-env-in-tests — tests isolate `API_TOKEN`
+- Since: 2026-10-23
+- Decision: every test clears `process.env.API_TOKEN` in `beforeEach` and restores it in `afterEach`.
+- Reason: a developer's real `API_TOKEN` must never leak into a test run (incident 2026-09-19).
diff --git a/src/auth/token.mjs b/src/auth/token.mjs
index 97ea029..6a14259 100644
--- a/src/auth/token.mjs
+++ b/src/auth/token.mjs
@@ -4,5 +4,9 @@ export function resolveToken(options = {}) {
   if (typeof options.token === "string" && options.token.length > 0) {
     return options.token;
   }
-  throw new Error("resolveToken: pass { token } explicitly");
+  const fromEnv = process.env.API_TOKEN;
+  if (typeof fromEnv === "string" && fromEnv.length > 0) {
+    return fromEnv;
+  }
+  throw new Error("resolveToken: pass { token } or set API_TOKEN");
 }
diff --git a/src/auth/token.test.mjs b/src/auth/token.test.mjs
index aa37c42..d7b86f3 100644
--- a/src/auth/token.test.mjs
+++ b/src/auth/token.test.mjs
@@ -1,7 +1,39 @@
-import { test } from "node:test";
+import { test, beforeEach, afterEach } from "node:test";
 import assert from "node:assert/strict";
 import { resolveToken } from "./token.mjs";
 
+let savedEnv;
+beforeEach(() => {
+  savedEnv = process.env.API_TOKEN;
+  delete process.env.API_TOKEN;
+});
+afterEach(() => {
+  if (savedEnv === undefined) delete process.env.API_TOKEN;
+  else process.env.API_TOKEN = savedEnv;
+});
+
 test("returns the explicit token", () => {
   assert.equal(resolveToken({ token: "abc" }), "abc");
 });
+
+test("falls back to API_TOKEN when no token is passed", () => {
+  process.env.API_TOKEN = "from-env";
+  assert.equal(resolveToken(), "from-env");
+  assert.equal(resolveToken({}), "from-env");
+});
+
+test("explicit token wins over API_TOKEN", () => {
+  process.env.API_TOKEN = "from-env";
+  assert.equal(resolveToken({ token: "abc" }), "abc");
+});
+
+test("empty explicit token falls back to API_TOKEN", () => {
+  process.env.API_TOKEN = "from-env";
+  assert.equal(resolveToken({ token: "" }), "from-env");
+});
+
+test("throws when neither token nor API_TOKEN is set", () => {
+  assert.throws(() => resolveToken(), /API_TOKEN/);
+  process.env.API_TOKEN = "";
+  assert.throws(() => resolveToken({}), /API_TOKEN/);
+});
