@@ -9,6 +9,16 @@ export function openTab(state, title) {
   return { next: state.next + 1, tabs: [...state.tabs, { key, title }] };
 }
 
+/**
+ * Removes the tab with the given key. Remaining tabs keep their keys, so closing
+ * leaves a gap (`t1,t3`) rather than renumbering.
+ *
+ * @param {{ next: number, tabs: Array<{ key: string, title: string }> }} state
+ *   Current tab strip state.
+ * @param {string} key Key of the tab to close (e.g. `"t2"`). An unknown key is a no-op.
+ * @returns {{ next: number, tabs: Array<{ key: string, title: string }> }}
+ *   A new state with the tab removed; `next` is unchanged and `state` is not mutated.
+ */
 export function closeTab(state, key) {
   return { ...state, tabs: state.tabs.filter((tab) => tab.key !== key) };
 }
