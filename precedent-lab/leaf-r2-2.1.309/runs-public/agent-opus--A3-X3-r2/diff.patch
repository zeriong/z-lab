-import { test } from "node:test";
+import { test, beforeEach, afterEach } from "node:test";
 import assert from "node:assert/strict";
 import { resolveToken } from "./token.mjs";
 
+// Every test starts with API_TOKEN unset so a developer's exported token never leaks in,
+// and the original value is put back afterwards.
+let savedApiToken;
+
+beforeEach(() => {
+  savedApiToken = process.env.API_TOKEN;
+  delete process.env.API_TOKEN;
+});
+
+afterEach(() => {
+  if (savedApiToken === undefined) {
+    delete process.env.API_TOKEN;
+  } else {
+    process.env.API_TOKEN = savedApiToken;
+  }
+});
+
 test("returns the explicit token", () => {
   assert.equal(resolveToken({ token: "abc" }), "abc");
 });
+
+test("an explicit token wins over API_TOKEN", () => {
+  process.env.API_TOKEN = "from-env";
+  assert.equal(resolveToken({ token: "abc" }), "abc");
+});
+
+test("falls back to API_TOKEN when no token is passed", () => {
+  process.env.API_TOKEN = "from-env";
+  assert.equal(resolveToken({}), "from-env");
+  assert.equal(resolveToken(), "from-env");
+});
+
+test("an empty explicit token counts as missing and falls back to API_TOKEN", () => {
+  process.env.API_TOKEN = "from-env";
+  assert.equal(resolveToken({ token: "" }), "from-env");
+});
+
+test("throws when neither a token nor API_TOKEN is set", () => {
+  assert.throws(() => resolveToken({}), /pass \{ token \} explicitly/);
+  assert.throws(() => resolveToken(), /pass \{ token \} explicitly/);
+});
+
+test("an empty API_TOKEN counts as missing", () => {
+  process.env.API_TOKEN = "";
+  assert.throws(() => resolveToken({}), /pass \{ token \} explicitly/);
+  assert.throws(() => resolveToken({ token: "" }), /pass \{ token \} explicitly/);
+});
