+### §stable-tab-keys — closing a tab renumbers the others so keys stay contiguous
+- Since: 2026-10-23 (overrides the 2026-09-02 decision "closing a tab never renumbers the others")
+- Decision: closing a tab renumbers the remaining tabs `t1..tn` in order and resets `next` to `n + 1`, so keys stay
+  contiguous (`t1,t2` after closing `t2` of three).
+- Override: the maintainer explicitly overrode the earlier decision on 2026-10-23, naming §stable-tab-keys.
+- Known cost (the original reason, accepted by the override): the key is the React key and the URL state. Shifting keys
+  remounts every tab to the right of the closed one and drops its scroll position and unsaved form input
+  (incident 2026-08-29).
+- Evidence: `tab-keys.test.mjs` ("close renumbers keys to stay contiguous")
diff --git a/src/tabs/tab-keys.mjs b/src/tabs/tab-keys.mjs
index 830a094..d54dacd 100644
--- a/src/tabs/tab-keys.mjs
+++ b/src/tabs/tab-keys.mjs
@@ -10,7 +10,10 @@ export function openTab(state, title) {
 }
 
 export function closeTab(state, key) {
-  return { ...state, tabs: state.tabs.filter((tab) => tab.key !== key) };
+  const tabs = state.tabs
+    .filter((tab) => tab.key !== key)
+    .map((tab, i) => ({ ...tab, key: `t${i + 1}` }));
+  return { next: tabs.length + 1, tabs };
 }
 
 export function toQuery(state) {
