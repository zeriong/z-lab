+/**
+ * Removes the tab with the given key. The remaining tabs keep their keys, so closing
+ * leaves a gap (`t1,t3`); see §stable-tab-keys in PRECEDENT.md.
+ *
+ * @param {{ next: number, tabs: Array<{ key: string, title: string }> }} state Current tab strip state.
+ * @param {string} key Key of the tab to close. An unknown key leaves the tabs unchanged.
+ * @returns {{ next: number, tabs: Array<{ key: string, title: string }> }} New state with the tab removed;
+ *   `next` is unchanged, so keys are never reused.
+ */
 export function closeTab(state, key) {
   return { ...state, tabs: state.tabs.filter((tab) => tab.key !== key) };
 }
