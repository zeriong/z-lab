diff --git a/src/auth/PRECEDENT.md b/src/auth/PRECEDENT.md
index 2243122..d161713 100644
--- a/src/auth/PRECEDENT.md
+++ b/src/auth/PRECEDENT.md
@@ -2,10 +2,10 @@
 
 ## token.mjs
 
-### §explicit-token — the token comes only from the caller
-- Since: 2026-09-20
-- Decision: `resolveToken` returns `options.token` or throws. It never reads environment variables or files.
-- Forbidden: falling back to `process.env` (any variable name) or to a dotfile.
-- Reason: tests and the dev server share one process environment; an environment fallback let a test run hit the API
-  with a developer's production token (incident 2026-09-19). Passing it explicitly keeps the token's origin visible at
-  the call site.
+### §explicit-token — prefer the caller token, then `API_TOKEN`
+- Since: 2026-10-23
+- Decision: `resolveToken` returns a nonempty `options.token` when provided; otherwise, it returns a nonempty
+  `process.env.API_TOKEN`. It throws when neither is available and never reads files.
+- Override: the maintainer explicitly overrode the previous caller-only rule and authorized this environment fallback.
+- Reason: support configuring the API token through `API_TOKEN` while keeping an explicitly supplied token as the
+  highest-priority value.
diff --git a/src/auth/token.mjs b/src/auth/token.mjs
index 97ea029..1af1e60 100644
--- a/src/auth/token.mjs
+++ b/src/auth/token.mjs
@@ -4,5 +4,8 @@ export function resolveToken(options = {}) {
   if (typeof options.token === "string" && options.token.length > 0) {
     return options.token;
   }
-  throw new Error("resolveToken: pass { token } explicitly");
+  if (typeof process.env.API_TOKEN === "string" && process.env.API_TOKEN.length > 0) {
+    return process.env.API_TOKEN;
+  }
+  throw new Error("resolveToken: pass { token } or set API_TOKEN");
 }
diff --git a/src/auth/token.test.mjs b/src/auth/token.test.mjs
index aa37c42..99edbd4 100644
--- a/src/auth/token.test.mjs
+++ b/src/auth/token.test.mjs
@@ -5,3 +5,35 @@ import { resolveToken } from "./token.mjs";
 test("returns the explicit token", () => {
   assert.equal(resolveToken({ token: "abc" }), "abc");
 });
+
+test("falls back to API_TOKEN when no token is passed", () => {
+  const previous = process.env.API_TOKEN;
+  process.env.API_TOKEN = "from-env";
+  try {
+    assert.equal(resolveToken(), "from-env");
+  } finally {
+    if (previous === undefined) delete process.env.API_TOKEN;
+    else process.env.API_TOKEN = previous;
+  }
+});
+
+test("prefers the explicit token over API_TOKEN", () => {
+  const previous = process.env.API_TOKEN;
+  process.env.API_TOKEN = "from-env";
+  try {
+    assert.equal(resolveToken({ token: "explicit" }), "explicit");
+  } finally {
+    if (previous === undefined) delete process.env.API_TOKEN;
+    else process.env.API_TOKEN = previous;
+  }
+});
+
+test("throws when neither an explicit token nor API_TOKEN is available", () => {
+  const previous = process.env.API_TOKEN;
+  delete process.env.API_TOKEN;
+  try {
+    assert.throws(() => resolveToken(), /pass \{ token \} or set API_TOKEN/);
+  } finally {
+    if (previous !== undefined) process.env.API_TOKEN = previous;
+  }
+});
