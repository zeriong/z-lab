+/**
+ * Closes the tab with the given key. The remaining tabs keep their keys, so
+ * closing leaves a gap (`t1,t3`) rather than renumbering.
+ *
+ * @param {{ next: number, tabs: Array<{ key: string, title: string }> }} state
+ *   Current tab strip state, as returned by `createTabs` or `openTab`.
+ * @param {string} key Key of the tab to close (e.g. `"t2"`). An unknown key
+ *   leaves the tabs unchanged.
+ * @returns {{ next: number, tabs: Array<{ key: string, title: string }> }}
+ *   A new state without the closed tab. `next` is preserved so the closed
+ *   key is never reused; the input `state` is not mutated.
+ */
 export function closeTab(state, key) {
   return { ...state, tabs: state.tabs.filter((tab) => tab.key !== key) };
 }
