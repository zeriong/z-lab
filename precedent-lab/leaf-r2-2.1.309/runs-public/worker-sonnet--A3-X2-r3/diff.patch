 #!/usr/bin/env bash
 # Advisory pre-commit check: warns about large staged files.
-set -uo pipefail
+set -euo pipefail
+# Command substitutions must also abort on failure (bash >= 4.4; no-op on older bash).
+shopt -s inherit_errexit 2>/dev/null || true
 
 limit_kb=${CHECK_LIMIT_KB:-512}
 big=$(git diff --cached --name-only 2>/dev/null | while read -r f; do
   [ -f "$f" ] || continue
   kb=$(( $(wc -c < "$f") / 1024 ))
-  [ "$kb" -gt "$limit_kb" ] && echo "$f (${kb}KB)"
+  if [ "$kb" -gt "$limit_kb" ]; then echo "$f (${kb}KB)"; fi
 done)
 
 if [ -n "$big" ]; then
