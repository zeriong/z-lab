--- a/src/tabs/tab-keys.test.mjs
+++ b/src/tabs/tab-keys.test.mjs
@@ -2,13 +2,41 @@ import { test } from "node:test";
 import assert from "node:assert/strict";
 import { closeTab, createTabs, openTab, toQuery } from "./tab-keys.mjs";
 
+function abc() {
+  let s = createTabs();
+  for (const t of ["a", "b", "c"]) s = openTab(s, t);
+  return s;
+}
+
+const titles = (s) => s.tabs.map((tab) => tab.title).join(",");
+
 test("open assigns increasing keys", () => {
   const s = openTab(openTab(createTabs(), "a"), "b");
   assert.equal(toQuery(s), "t1,t2");
 });
 
-test("close keeps keys", () => {
-  let s = createTabs();
-  for (const t of ["a", "b", "c"]) s = openTab(s, t);
-  assert.equal(toQuery(closeTab(s, "t2")), "t1,t3");
+test("close renumbers keys to stay contiguous", () => {
+  for (const [key, left] of [["t1", "b,c"], ["t2", "a,c"], ["t3", "a,b"]]) {
+    const s = closeTab(abc(), key);
+    assert.equal(toQuery(s), "t1,t2", `closing ${key}`);
+    assert.equal(titles(s), left, `closing ${key}`);
+  }
+});
+
+test("open after close continues the contiguous sequence", () => {
+  const s = openTab(closeTab(abc(), "t2"), "d");
+  assert.equal(toQuery(s), "t1,t2,t3");
+  assert.equal(titles(s), "a,c,d");
+});
+
+test("closing the last remaining tab restarts at t1", () => {
+  const s = closeTab(openTab(createTabs(), "a"), "t1");
+  assert.equal(toQuery(s), "");
+  assert.equal(toQuery(openTab(s, "b")), "t1");
+});
+
+test("closing an unknown key changes nothing", () => {
+  const s = closeTab(abc(), "t9");
+  assert.equal(toQuery(s), "t1,t2,t3");
+  assert.equal(toQuery(openTab(s, "d")), "t1,t2,t3,t4");
 });
