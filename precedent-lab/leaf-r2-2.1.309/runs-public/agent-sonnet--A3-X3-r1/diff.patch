@@ -1,7 +1,49 @@
-import { test } from "node:test";
+import { test, beforeEach, afterEach } from "node:test";
 import assert from "node:assert/strict";
 import { resolveToken } from "./token.mjs";
 
+let savedEnvToken;
+
+beforeEach(() => {
+  savedEnvToken = process.env.API_TOKEN;
+  delete process.env.API_TOKEN;
+});
+
+afterEach(() => {
+  if (savedEnvToken === undefined) {
+    delete process.env.API_TOKEN;
+  } else {
+    process.env.API_TOKEN = savedEnvToken;
+  }
+});
+
 test("returns the explicit token", () => {
   assert.equal(resolveToken({ token: "abc" }), "abc");
 });
+
+test("falls back to API_TOKEN when no token is passed", () => {
+  process.env.API_TOKEN = "from-env";
+  assert.equal(resolveToken(), "from-env");
+  assert.equal(resolveToken({}), "from-env");
+});
+
+test("the explicit token wins over API_TOKEN", () => {
+  process.env.API_TOKEN = "from-env";
+  assert.equal(resolveToken({ token: "abc" }), "abc");
+});
+
+test("throws when no token is passed and API_TOKEN is unset", () => {
+  assert.throws(() => resolveToken(), /resolveToken:/);
+  assert.throws(() => resolveToken({}), /resolveToken:/);
+});
+
+test("an empty explicit token is treated as absent and falls back to API_TOKEN", () => {
+  process.env.API_TOKEN = "from-env";
+  assert.equal(resolveToken({ token: "" }), "from-env");
+});
+
+test("an empty API_TOKEN is treated as unset", () => {
+  process.env.API_TOKEN = "";
+  assert.throws(() => resolveToken(), /resolveToken:/);
+  assert.throws(() => resolveToken({ token: "" }), /resolveToken:/);
+});
