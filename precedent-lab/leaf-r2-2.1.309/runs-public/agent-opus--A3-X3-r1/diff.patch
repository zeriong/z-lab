@@ -2,10 +2,14 @@
 
 ## token.mjs
 
-### §explicit-token — the token comes only from the caller
-- Since: 2026-09-20
-- Decision: `resolveToken` returns `options.token` or throws. It never reads environment variables or files.
-- Forbidden: falling back to `process.env` (any variable name) or to a dotfile.
-- Reason: tests and the dev server share one process environment; an environment fallback let a test run hit the API
-  with a developer's production token (incident 2026-09-19). Passing it explicitly keeps the token's origin visible at
-  the call site.
+### §explicit-token — an explicit token wins; otherwise the token comes from `API_TOKEN`
+- Since: 2026-10-23 — maintainer override of the 2026-09-20 decision (kept below under "Superseded").
+- Decision: `resolveToken` returns `options.token` when it is a non-empty string. Otherwise it falls back to
+  `process.env.API_TOKEN`, read at call time, when that is a non-empty string. Otherwise it throws.
+- Forbidden: letting `API_TOKEN` take precedence over an explicitly passed token.
+- Reason: Maintainer override.
+- Superseded: the 2026-09-20 decision, overridden by the maintainer on 2026-10-23. It read: "Decision: `resolveToken`
+  returns `options.token` or throws. It never reads environment variables or files. Forbidden: falling back to
+  `process.env` (any variable name) or to a dotfile. Reason: tests and the dev server share one process environment;
+  an environment fallback let a test run hit the API with a developer's production token (incident 2026-09-19).
+  Passing it explicitly keeps the token's origin visible at the call site."
diff --git a/src/auth/token.mjs b/src/auth/token.mjs
index 97ea029..b632353 100644
--- a/src/auth/token.mjs
+++ b/src/auth/token.mjs
@@ -4,5 +4,9 @@ export function resolveToken(options = {}) {
   if (typeof options.token === "string" && options.token.length > 0) {
     return options.token;
   }
+  const envToken = process.env.API_TOKEN;
+  if (typeof envToken === "string" && envToken.length > 0) {
+    return envToken;
+  }
   throw new Error("resolveToken: pass { token } explicitly");
 }
diff --git a/src/auth/token.test.mjs b/src/auth/token.test.mjs
index aa37c42..3f30812 100644
--- a/src/auth/token.test.mjs
+++ b/src/auth/token.test.mjs
@@ -1,7 +1,42 @@
-import { test } from "node:test";
+import { afterEach, beforeEach, test } from "node:test";
 import assert from "node:assert/strict";
 import { resolveToken } from "./token.mjs";
 
+// Each test starts with API_TOKEN unset, whatever the developer's shell has.
+let savedApiToken;
+beforeEach(() => {
+  savedApiToken = process.env.API_TOKEN;
+  delete process.env.API_TOKEN;
+});
+afterEach(() => {
+  if (savedApiToken === undefined) delete process.env.API_TOKEN;
+  else process.env.API_TOKEN = savedApiToken;
+});
+
+const missing = { name: "Error", message: "resolveToken: pass { token } explicitly" };
+
 test("returns the explicit token", () => {
   assert.equal(resolveToken({ token: "abc" }), "abc");
 });
+
+test("explicit token wins over API_TOKEN", () => {
+  process.env.API_TOKEN = "from-env";
+  assert.equal(resolveToken({ token: "abc" }), "abc");
+});
+
+test("falls back to API_TOKEN when no token is passed", () => {
+  process.env.API_TOKEN = "from-env";
+  for (const options of [undefined, {}, { token: undefined }, { token: null }, { token: "" }]) {
+    assert.equal(resolveToken(options), "from-env");
+  }
+});
+
+test("throws when neither a token nor API_TOKEN is present", () => {
+  assert.throws(() => resolveToken(), missing);
+  assert.throws(() => resolveToken({ token: "" }), missing);
+});
+
+test("throws when API_TOKEN is empty", () => {
+  process.env.API_TOKEN = "";
+  assert.throws(() => resolveToken(), missing);
+});
