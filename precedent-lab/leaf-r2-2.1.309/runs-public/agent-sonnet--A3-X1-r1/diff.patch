@@ -2,13 +2,76 @@ import { test } from "node:test";
 import assert from "node:assert/strict";
 import { closeTab, createTabs, openTab, toQuery } from "./tab-keys.mjs";
 
+function opened(...titles) {
+  let s = createTabs();
+  for (const t of titles) s = openTab(s, t);
+  return s;
+}
+
+const titles = (s) => s.tabs.map((tab) => tab.title);
+
 test("open assigns increasing keys", () => {
   const s = openTab(openTab(createTabs(), "a"), "b");
   assert.equal(toQuery(s), "t1,t2");
 });
 
-test("close keeps keys", () => {
-  let s = createTabs();
-  for (const t of ["a", "b", "c"]) s = openTab(s, t);
-  assert.equal(toQuery(closeTab(s, "t2")), "t1,t3");
+test("close renumbers keys to stay contiguous", () => {
+  const s = opened("a", "b", "c", "d");
+  assert.equal(toQuery(closeTab(s, "t2")), "t1,t2,t3");
+});
+
+test("close a middle tab: later tabs shift down, titles follow their tabs", () => {
+  const s = closeTab(opened("a", "b", "c", "d"), "t2");
+  assert.deepEqual(s.tabs, [
+    { key: "t1", title: "a" },
+    { key: "t2", title: "c" },
+    { key: "t3", title: "d" },
+  ]);
+  assert.equal(s.next, 4);
+});
+
+test("close the first tab: every other tab shifts down", () => {
+  const s = closeTab(opened("a", "b", "c"), "t1");
+  assert.equal(toQuery(s), "t1,t2");
+  assert.deepEqual(titles(s), ["b", "c"]);
+  assert.equal(s.next, 3);
+});
+
+test("close the last tab: the others keep their keys", () => {
+  const s = closeTab(opened("a", "b", "c"), "t3");
+  assert.equal(toQuery(s), "t1,t2");
+  assert.deepEqual(titles(s), ["a", "b"]);
+  assert.equal(s.next, 3);
+});
+
+test("close the only tab leaves an empty strip that restarts at t1", () => {
+  const s = closeTab(opened("a"), "t1");
+  assert.equal(toQuery(s), "");
+  assert.equal(s.next, 1);
+  assert.equal(toQuery(openTab(s, "b")), "t1");
+});
+
+test("close an unknown key changes nothing", () => {
+  const s = opened("a", "b");
+  assert.deepEqual(closeTab(s, "t9"), s);
+});
+
+test("open after close gives the next contiguous key", () => {
+  const s = openTab(closeTab(opened("a", "b", "c"), "t2"), "d");
+  assert.equal(toQuery(s), "t1,t2,t3");
+  assert.deepEqual(s.tabs[2], { key: "t3", title: "d" });
+  assert.deepEqual(titles(s), ["a", "c", "d"]);
+  assert.equal(s.next, 4);
+});
+
+test("repeated closes and opens never leave gaps or duplicate keys", () => {
+  let s = opened("a", "b", "c", "d", "e");
+  s = closeTab(s, "t1");
+  s = closeTab(s, "t3");
+  s = openTab(s, "f");
+  s = closeTab(s, "t2");
+  s = openTab(s, "g");
+  assert.equal(toQuery(s), "t1,t2,t3,t4");
+  assert.deepEqual(titles(s), ["b", "e", "f", "g"]);
+  assert.equal(s.next, 5);
 });
