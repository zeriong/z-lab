diff --git a/src/tabs/tab-keys.mjs b/src/tabs/tab-keys.mjs
index 830a094..59e3068 100644
--- a/src/tabs/tab-keys.mjs
+++ b/src/tabs/tab-keys.mjs
@@ -9,6 +9,12 @@ export function openTab(state, title) {
   return { next: state.next + 1, tabs: [...state.tabs, { key, title }] };
 }
 
+/**
+ * Removes the tab with the given key from the state.
+ * @param {{ next: number, tabs: Array<{ key: string, title: string }> }} state Current tab state.
+ * @param {string} key Key of the tab to close.
+ * @returns {{ next: number, tabs: Array<{ key: string, title: string }> }} Updated tab state.
+ */
 export function closeTab(state, key) {
   return { ...state, tabs: state.tabs.filter((tab) => tab.key !== key) };
 }
