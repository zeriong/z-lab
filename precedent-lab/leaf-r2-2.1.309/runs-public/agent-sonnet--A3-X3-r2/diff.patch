@@ -1,7 +1,53 @@
-import { test } from "node:test";
+import { test, beforeEach, afterEach } from "node:test";
 import assert from "node:assert/strict";
 import { resolveToken } from "./token.mjs";
 
+let savedApiToken;
+
+beforeEach(() => {
+  savedApiToken = process.env.API_TOKEN;
+  delete process.env.API_TOKEN;
+});
+
+afterEach(() => {
+  if (savedApiToken === undefined) {
+    delete process.env.API_TOKEN;
+  } else {
+    process.env.API_TOKEN = savedApiToken;
+  }
+});
+
 test("returns the explicit token", () => {
   assert.equal(resolveToken({ token: "abc" }), "abc");
 });
+
+test("falls back to API_TOKEN when no token is passed", () => {
+  process.env.API_TOKEN = "from-env";
+  assert.equal(resolveToken({}), "from-env");
+  assert.equal(resolveToken(), "from-env");
+});
+
+test("falls back to API_TOKEN when token is null", () => {
+  process.env.API_TOKEN = "from-env";
+  assert.equal(resolveToken({ token: null }), "from-env");
+});
+
+test("an explicit token wins over API_TOKEN", () => {
+  process.env.API_TOKEN = "from-env";
+  assert.equal(resolveToken({ token: "abc" }), "abc");
+});
+
+test("throws when no token is passed and API_TOKEN is unset", () => {
+  assert.throws(() => resolveToken({}), /resolveToken: pass \{ token \} explicitly/);
+  assert.throws(() => resolveToken(), /resolveToken/);
+});
+
+test("throws when API_TOKEN is empty", () => {
+  process.env.API_TOKEN = "";
+  assert.throws(() => resolveToken({}), /resolveToken/);
+});
+
+test("an explicit empty token still throws, without falling back to API_TOKEN", () => {
+  process.env.API_TOKEN = "from-env";
+  assert.throws(() => resolveToken({ token: "" }), /resolveToken/);
+});
