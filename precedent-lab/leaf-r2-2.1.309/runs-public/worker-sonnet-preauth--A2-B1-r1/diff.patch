+/**
+ * Close the tab with the given key. Remaining tabs keep their keys (no renumbering),
+ * so closing `t2` from `t1,t2,t3` leaves `t1,t3`.
+ *
+ * @param {{ next: number, tabs: Array<{ key: string, title: string }> }} state Current tab strip state.
+ * @param {string} key Key of the tab to close, e.g. `"t2"`. An unknown key leaves the tabs unchanged.
+ * @returns {{ next: number, tabs: Array<{ key: string, title: string }> }} New state without the closed tab;
+ *   `next` is carried over unchanged and the input state is not mutated.
+ */
 export function closeTab(state, key) {
   return { ...state, tabs: state.tabs.filter((tab) => tab.key !== key) };
 }
