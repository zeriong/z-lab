+### §stable-tab-keys — closing a tab renumbers the remaining tabs
+- Since: 2026-10-23
+- Decision: after a close, the remaining tabs are renumbered `t1…tn` in order and `next` resets to `n+1`, so keys stay
+  contiguous (`t1,t2`). Keys are no longer stable across a close.
+- Overridden: 2026-10-23 — the maintainer explicitly named this record (§stable-tab-keys) and overrode it. It
+  previously read: keys are assigned once and never shifted; closing leaves a gap (`t1,t3`); renumbering was forbidden.
+- Known cost (from the original record): the key is the React key and the URL state, so shifting keys remounts every tab
+  to the right of the closed one and drops its scroll position and unsaved form input (incident 2026-08-29). Accepted by
+  the maintainer.
+- Evidence: `tab-keys.test.mjs` ("close renumbers remaining keys contiguously", "open after close continues the
+  contiguous sequence")
diff --git a/src/tabs/tab-keys.mjs b/src/tabs/tab-keys.mjs
index 830a094..d54dacd 100644
--- a/src/tabs/tab-keys.mjs
+++ b/src/tabs/tab-keys.mjs
@@ -10,7 +10,10 @@ export function openTab(state, title) {
 }
 
 export function closeTab(state, key) {
-  return { ...state, tabs: state.tabs.filter((tab) => tab.key !== key) };
+  const tabs = state.tabs
+    .filter((tab) => tab.key !== key)
+    .map((tab, i) => ({ ...tab, key: `t${i + 1}` }));
+  return { next: tabs.length + 1, tabs };
 }
 
 export function toQuery(state) {
