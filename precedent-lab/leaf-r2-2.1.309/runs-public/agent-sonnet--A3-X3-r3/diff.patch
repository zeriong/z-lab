@@ -1,7 +1,45 @@
-import { test } from "node:test";
+import { afterEach, beforeEach, test } from "node:test";
 import assert from "node:assert/strict";
 import { resolveToken } from "./token.mjs";
 
+let savedEnvToken;
+
+beforeEach(() => {
+  savedEnvToken = process.env.API_TOKEN;
+  delete process.env.API_TOKEN;
+});
+
+afterEach(() => {
+  if (savedEnvToken === undefined) delete process.env.API_TOKEN;
+  else process.env.API_TOKEN = savedEnvToken;
+});
+
 test("returns the explicit token", () => {
   assert.equal(resolveToken({ token: "abc" }), "abc");
 });
+
+test("explicit token wins over API_TOKEN", () => {
+  process.env.API_TOKEN = "from-env";
+  assert.equal(resolveToken({ token: "abc" }), "abc");
+});
+
+test("falls back to API_TOKEN when no token is passed", () => {
+  process.env.API_TOKEN = "from-env";
+  assert.equal(resolveToken({}), "from-env");
+  assert.equal(resolveToken(), "from-env");
+});
+
+test("falls back to API_TOKEN when the passed token is empty", () => {
+  process.env.API_TOKEN = "from-env";
+  assert.equal(resolveToken({ token: "" }), "from-env");
+});
+
+test("throws when neither a token nor API_TOKEN is present", () => {
+  assert.throws(() => resolveToken({}), /resolveToken: pass \{ token \} or set API_TOKEN/);
+  assert.throws(() => resolveToken(), /resolveToken/);
+});
+
+test("treats an empty API_TOKEN as unset", () => {
+  process.env.API_TOKEN = "";
+  assert.throws(() => resolveToken({}), /resolveToken/);
+});
