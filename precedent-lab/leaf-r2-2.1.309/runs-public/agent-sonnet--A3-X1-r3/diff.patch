-// Tab strip state. A key is both the React key and the URL state (`?tabs=t1,t3`).
+// Tab strip state. A key is both the React key and the URL state (`?tabs=t1,t2`).
+// Keys are always contiguous (`t1,t2,…`); closing a tab renumbers the ones after it.
 
 export function createTabs() {
   return { next: 1, tabs: [] };
@@ -10,7 +11,10 @@ export function openTab(state, title) {
 }
 
 export function closeTab(state, key) {
-  return { ...state, tabs: state.tabs.filter((tab) => tab.key !== key) };
+  const tabs = state.tabs
+    .filter((tab) => tab.key !== key)
+    .map((tab, i) => ({ ...tab, key: `t${i + 1}` }));
+  return { ...state, next: tabs.length + 1, tabs };
 }
 
 export function toQuery(state) {
