@@ -9,6 +9,18 @@ export function openTab(state, title) {
   return { next: state.next + 1, tabs: [...state.tabs, { key, title }] };
 }
 
+/**
+ * Removes the tab with the given key. The remaining tabs keep their keys (no
+ * renumbering), so closing `t2` of `t1,t2,t3` leaves `t1,t3`.
+ *
+ * @param {{ next: number, tabs: Array<{ key: string, title: string }> }} state
+ *   Current tab strip state, as returned by `createTabs` or `openTab`.
+ * @param {string} key Key of the tab to close (e.g. `"t2"`). An unknown key
+ *   is ignored.
+ * @returns {{ next: number, tabs: Array<{ key: string, title: string }> }} A new
+ *   state with the tab removed. `next` is unchanged, so the closed key is never
+ *   reused. The input state is not mutated.
+ */
 export function closeTab(state, key) {
   return { ...state, tabs: state.tabs.filter((tab) => tab.key !== key) };
 }
