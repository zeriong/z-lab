+/**
+ * Removes the tab with the given key. The remaining tabs keep their keys, so
+ * closing leaves a gap rather than renumbering (`t1,t3`).
+ *
+ * @param {{ next: number, tabs: Array<{ key: string, title: string }> }} state
+ *   Current tab strip state.
+ * @param {string} key Key of the tab to close. An unknown key is a no-op.
+ * @returns {{ next: number, tabs: Array<{ key: string, title: string }> }}
+ *   A new state without the closed tab; `next` is unchanged. `state` is not mutated.
+ */
 export function closeTab(state, key) {
   return { ...state, tabs: state.tabs.filter((tab) => tab.key !== key) };
 }
