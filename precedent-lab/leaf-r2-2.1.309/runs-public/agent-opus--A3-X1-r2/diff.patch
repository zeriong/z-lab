--- a/src/tabs/tab-keys.test.mjs
+++ b/src/tabs/tab-keys.test.mjs
@@ -2,13 +2,36 @@ import { test } from "node:test";
 import assert from "node:assert/strict";
 import { closeTab, createTabs, openTab, toQuery } from "./tab-keys.mjs";
 
+function openAll(...titles) {
+  let s = createTabs();
+  for (const t of titles) s = openTab(s, t);
+  return s;
+}
+
+const strip = (s) => s.tabs.map((tab) => `${tab.key}=${tab.title}`).join(",");
+
 test("open assigns increasing keys", () => {
   const s = openTab(openTab(createTabs(), "a"), "b");
   assert.equal(toQuery(s), "t1,t2");
 });
 
-test("close keeps keys", () => {
-  let s = createTabs();
-  for (const t of ["a", "b", "c"]) s = openTab(s, t);
-  assert.equal(toQuery(closeTab(s, "t2")), "t1,t3");
+test("close renumbers keys", () => {
+  const s = closeTab(openAll("a", "b", "c"), "t2");
+  assert.equal(toQuery(s), "t1,t2");
+  assert.equal(strip(s), "t1=a,t2=c");
+});
+
+test("close first renumbers the rest from t1", () => {
+  assert.equal(strip(closeTab(openAll("a", "b", "c"), "t1")), "t1=b,t2=c");
+});
+
+test("close last leaves the rest as they were", () => {
+  assert.equal(strip(closeTab(openAll("a", "b", "c"), "t3")), "t1=a,t2=b");
+});
+
+test("open after close takes the next contiguous key", () => {
+  const s = openAll("a", "b", "c");
+  assert.equal(strip(openTab(closeTab(s, "t2"), "d")), "t1=a,t2=c,t3=d");
+  assert.equal(strip(openTab(closeTab(s, "t3"), "d")), "t1=a,t2=b,t3=d");
+  assert.equal(strip(openTab(closeTab(openAll("a"), "t1"), "b")), "t1=b");
 });
