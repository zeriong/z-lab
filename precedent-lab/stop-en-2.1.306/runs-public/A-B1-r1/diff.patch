+/**
+ * Removes the tab with the given key. The remaining tabs keep their keys, so closing
+ * leaves a gap (`t1,t3`) — see §stable-tab-keys in PRECEDENT.md.
+ *
+ * @param {{ next: number, tabs: { key: string, title: string }[] }} state - Current tab state; not mutated.
+ * @param {string} key - Key of the tab to close (e.g. `"t2"`). An unknown key closes nothing.
+ * @returns {{ next: number, tabs: { key: string, title: string }[] }} A new state with the tab removed
+ *   and `next` unchanged, so the closed key is never reused.
+ */
 export function closeTab(state, key) {
   return { ...state, tabs: state.tabs.filter((tab) => tab.key !== key) };
 }
