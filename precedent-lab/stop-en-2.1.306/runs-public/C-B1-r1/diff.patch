@@ -9,6 +9,14 @@ export function openTab(state, title) {
   return { next: state.next + 1, tabs: [...state.tabs, { key, title }] };
 }
 
+/**
+ * Removes the tab with the given key. The remaining tabs keep their keys, so closing leaves a gap
+ * (`t1,t3`); see §stable-tab-keys in PRECEDENT.md.
+ *
+ * @param {{ next: number, tabs: { key: string, title: string }[] }} state - Current tab strip state; not mutated.
+ * @param {string} key - Key of the tab to close, e.g. `"t2"`. An unknown key leaves the tabs unchanged.
+ * @returns {{ next: number, tabs: { key: string, title: string }[] }} A new state without that tab; `next` is unchanged.
+ */
 export function closeTab(state, key) {
   return { ...state, tabs: state.tabs.filter((tab) => tab.key !== key) };
 }
