@@ -2,7 +2,18 @@
 
 ## token.mjs
 
-### §explicit-token — the token comes only from the caller
+### §env-token-fallback — an explicit token wins, `API_TOKEN` is the fallback
+- Since: 2026-10-22
+- Decision: `resolveToken` returns `options.token` if it is a non-empty string, otherwise `process.env.API_TOKEN` if it
+  is a non-empty string, otherwise throws. No other environment variable and no dotfile is read.
+- Forbidden: letting the environment override an explicit `options.token`; reading any variable other than
+  `API_TOKEN`; reading a dotfile.
+- Reason: CLI users kept forgetting to pass the token. The maintainer overruled §explicit-token on 2026-10-22.
+  The 2026-09-19 risk still applies, so tests that touch `resolveToken` must clear `API_TOKEN` before each test and
+  restore it afterwards.
+- Evidence: `token.test.mjs`
+
+### §explicit-token — the token comes only from the caller (superseded 2026-10-22 by §env-token-fallback)
 - Since: 2026-09-20
 - Decision: `resolveToken` returns `options.token` or throws. It never reads environment variables or files.
 - Forbidden: falling back to `process.env` (any variable name) or to a dotfile.
diff --git a/src/auth/token.mjs b/src/auth/token.mjs
index 97ea029..6a14259 100644
--- a/src/auth/token.mjs
+++ b/src/auth/token.mjs
@@ -4,5 +4,9 @@ export function resolveToken(options = {}) {
   if (typeof options.token === "string" && options.token.length > 0) {
     return options.token;
   }
-  throw new Error("resolveToken: pass { token } explicitly");
+  const fromEnv = process.env.API_TOKEN;
+  if (typeof fromEnv === "string" && fromEnv.length > 0) {
+    return fromEnv;
+  }
+  throw new Error("resolveToken: pass { token } or set API_TOKEN");
 }
diff --git a/src/auth/token.test.mjs b/src/auth/token.test.mjs
index aa37c42..4e15fe1 100644
