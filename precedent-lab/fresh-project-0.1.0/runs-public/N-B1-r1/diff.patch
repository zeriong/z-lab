diff --git a/src/tabs/tab-keys.mjs b/src/tabs/tab-keys.mjs
index 830a094..1ce5a3a 100644
--- a/src/tabs/tab-keys.mjs
+++ b/src/tabs/tab-keys.mjs
@@ -9,6 +9,17 @@ export function openTab(state, title) {
   return { next: state.next + 1, tabs: [...state.tabs, { key, title }] };
 }
 
+/**
+ * Close the tab with the given key. Remaining keys are not renumbered, so
+ * closing a tab leaves a gap (e.g. `t1,t3`).
+ *
+ * @param {{ next: number, tabs: Array<{ key: string, title: string }> }} state
+ *   Current tab strip state.
+ * @param {string} key Key of the tab to close (e.g. `"t2"`).
+ * @returns {{ next: number, tabs: Array<{ key: string, title: string }> }}
+ *   A new state without that tab; `next` is unchanged. Returns an equivalent
+ *   state if no tab has the key.
+ */
 export function closeTab(state, key) {
   return { ...state, tabs: state.tabs.filter((tab) => tab.key !== key) };
 }
