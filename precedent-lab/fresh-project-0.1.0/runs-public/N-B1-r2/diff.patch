 }
 
+/**
+ * Closes the tab with the given key. Remaining keys are left as-is, so a
+ * close leaves a gap (`t1,t3`); keys are never renumbered.
+ *
+ * @param {{ next: number, tabs: { key: string, title: string }[] }} state - Current tab state.
+ * @param {string} key - Key of the tab to close (e.g. `"t2"`).
+ * @returns {{ next: number, tabs: { key: string, title: string }[] }} A new state without that tab;
+ *   `next` is unchanged. Returns an equivalent state if no tab has that key.
+ */
 export function closeTab(state, key) {
   return { ...state, tabs: state.tabs.filter((tab) => tab.key !== key) };
 }
