@@ -9,6 +9,15 @@ export function openTab(state, title) {
   return { next: state.next + 1, tabs: [...state.tabs, { key, title }] };
 }
 
+/**
+ * Removes the tab with the given key. The remaining keys are left as they are,
+ * so closing a tab leaves a gap (`t1,t3`).
+ *
+ * @param {{ next: number, tabs: { key: string, title: string }[] }} state - Current tab strip state.
+ * @param {string} key - Key of the tab to close, e.g. `"t2"`.
+ * @returns {{ next: number, tabs: { key: string, title: string }[] }} A new state without that tab;
+ *   `next` is unchanged. Returns an equivalent copy if no tab has `key`.
+ */
 export function closeTab(state, key) {
   return { ...state, tabs: state.tabs.filter((tab) => tab.key !== key) };
 }
