@@ -9,8 +9,10 @@ export function openTab(state, title) {
   return { next: state.next + 1, tabs: [...state.tabs, { key, title }] };
 }
 
+// Renumbers the remaining tabs so keys stay contiguous (t1..tN); see §contiguous-tab-keys.
 export function closeTab(state, key) {
-  return { ...state, tabs: state.tabs.filter((tab) => tab.key !== key) };
+  const tabs = state.tabs.filter((tab) => tab.key !== key).map((tab, i) => ({ ...tab, key: `t${i + 1}` }));
+  return { next: tabs.length + 1, tabs };
 }
 
