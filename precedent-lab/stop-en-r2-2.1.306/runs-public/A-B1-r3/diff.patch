+/**
+ * Close the tab with the given key. The remaining tabs keep their keys, so closing
+ * `t2` from `t1,t2,t3` leaves `t1,t3` (see PRECEDENT.md §stable-tab-keys).
+ *
+ * @param {{ next: number, tabs: { key: string, title: string }[] }} state - Current tab strip state; not mutated.
+ * @param {string} key - Key of the tab to close. An unknown key leaves the tabs unchanged.
+ * @returns {{ next: number, tabs: { key: string, title: string }[] }} A new state without that tab;
+ *   `next` is unchanged, so closed keys are never reused.
+ */
 export function closeTab(state, key) {
   return { ...state, tabs: state.tabs.filter((tab) => tab.key !== key) };
 }
