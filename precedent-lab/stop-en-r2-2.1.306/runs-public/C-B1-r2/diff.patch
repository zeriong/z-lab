+/**
+ * Removes the tab with the given key. The remaining tabs keep their keys, so a close
+ * leaves a gap (`t1,t3`) rather than renumbering — see §stable-tab-keys in PRECEDENT.md.
+ *
+ * @param {{ next: number, tabs: { key: string, title: string }[] }} state - Current tab strip state.
+ * @param {string} key - Key of the tab to close, e.g. `"t2"`. An unknown key is a no-op.
+ * @returns {{ next: number, tabs: { key: string, title: string }[] }} A new state without that tab;
+ *   `next` is unchanged so keys are never reused.
+ */
 export function closeTab(state, key) {
   return { ...state, tabs: state.tabs.filter((tab) => tab.key !== key) };
 }
