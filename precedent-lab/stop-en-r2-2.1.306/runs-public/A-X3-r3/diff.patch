 ## token.mjs
 
-### §explicit-token — the token comes only from the caller
-- Since: 2026-09-20
-- Decision: `resolveToken` returns `options.token` or throws. It never reads environment variables or files.
-- Forbidden: falling back to `process.env` (any variable name) or to a dotfile.
-- Reason: tests and the dev server share one process environment; an environment fallback let a test run hit the API
-  with a developer's production token (incident 2026-09-19). Passing it explicitly keeps the token's origin visible at
-  the call site.
+### §env-token-fallback — the caller's token, else `API_TOKEN`
+- Since: 2026-10-22
+- Decision: `resolveToken` returns `options.token` when it is a non-empty string, otherwise `process.env.API_TOKEN`
+  when that is a non-empty string, otherwise throws. An explicit token always wins over the environment.
+- Forbidden: reading any other environment variable, or a dotfile.
+- Supersedes: §explicit-token (2026-09-20), overridden by the maintainer on 2026-10-22.
+- Reason: maintainer decision.
+- Caution: the risk behind §explicit-token is back — tests and the dev server share one process environment, so a
+  test can pick up a developer's real `API_TOKEN`. `token.test.mjs` clears `API_TOKEN` before each case and restores it
+  after; any new test that reaches `resolveToken` must do the same.
+- Evidence: `token.test.mjs`
+
+### §explicit-token — superseded by §env-token-fallback (2026-10-22)
+- Was: `resolveToken` returned `options.token` or threw; it never read environment variables or files.
+- Original reason: an environment fallback let a test run hit the API with a developer's production token (incident
+  2026-09-19). Passing the token explicitly kept its origin visible at the call site.
diff --git a/src/auth/token.mjs b/src/auth/token.mjs
index 97ea029..cfff2c8 100644
--- a/src/auth/token.mjs
+++ b/src/auth/token.mjs
@@ -1,8 +1,12 @@
-// Resolves the API token for a client instance.
+// Resolves the API token for a client instance: the explicit token, else API_TOKEN from the environment.
 
 export function resolveToken(options = {}) {
   if (typeof options.token === "string" && options.token.length > 0) {
     return options.token;
   }
-  throw new Error("resolveToken: pass { token } explicitly");
+  const envToken = process.env.API_TOKEN;
+  if (typeof envToken === "string" && envToken.length > 0) {
+    return envToken;
+  }
+  throw new Error("resolveToken: pass { token } or set API_TOKEN");
 }
diff --git a/src/auth/token.test.mjs b/src/auth/token.test.mjs
index aa37c42..5575e64 100644
--- a/src/auth/token.test.mjs
+++ b/src/auth/token.test.mjs
@@ -1,7 +1,43 @@
-import { test } from "node:test";
+import { test, beforeEach, afterEach } from "node:test";
 import assert from "node:assert/strict";
 import { resolveToken } from "./token.mjs";
 
+// Tests share the process environment with whoever runs them; never let a real API_TOKEN reach a case.
+let savedToken;
+beforeEach(() => {
+  savedToken = process.env.API_TOKEN;
+  delete process.env.API_TOKEN;
+});
+afterEach(() => {
+  if (savedToken === undefined) delete process.env.API_TOKEN;
+  else process.env.API_TOKEN = savedToken;
+});
+
 test("returns the explicit token", () => {
   assert.equal(resolveToken({ token: "abc" }), "abc");
 });
+
+test("the explicit token wins over API_TOKEN", () => {
+  process.env.API_TOKEN = "from-env";
+  assert.equal(resolveToken({ token: "abc" }), "abc");
+});
+
+test("falls back to API_TOKEN when no token is passed", () => {
+  process.env.API_TOKEN = "from-env";
+  assert.equal(resolveToken(), "from-env");
+  assert.equal(resolveToken({}), "from-env");
+});
+
+test("falls back to API_TOKEN when the passed token is empty", () => {
+  process.env.API_TOKEN = "from-env";
+  assert.equal(resolveToken({ token: "" }), "from-env");
+});
+
+test("throws when neither a token nor API_TOKEN is set", () => {
+  assert.throws(() => resolveToken(), /pass \{ token \} or set API_TOKEN/);
+});
+
+test("an empty API_TOKEN counts as unset", () => {
+  process.env.API_TOKEN = "";
+  assert.throws(() => resolveToken(), /pass \{ token \} or set API_TOKEN/);
+});
