+test("keys stay contiguous across several closes", () => {
+  let s = createTabs();
+  for (const t of ["a", "b", "c", "d", "e", "f", "g"]) s = openTab(s, t);
+  for (const key of ["t2", "t2", "t3", "t3"]) s = closeTab(s, key);
+  assert.equal(toQuery(s), "t1,t2,t3");
+  assert.deepEqual(s.tabs.map((tab) => tab.title), ["a", "d", "g"]);
+});
+
+test("open after close continues from the renumbered keys", () => {
+  let s = createTabs();
+  for (const t of ["a", "b", "c"]) s = openTab(s, t);
+  s = openTab(closeTab(s, "t1"), "d");
+  assert.equal(toQuery(s), "t1,t2,t3");
+  assert.deepEqual(s.tabs.map((tab) => tab.title), ["b", "c", "d"]);
