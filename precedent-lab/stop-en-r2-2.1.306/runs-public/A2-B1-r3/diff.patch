+/**
+ * Closes the tab with the given key.
+ *
+ * The remaining tabs keep their keys, so closing one leaves a gap (`t1,t3`).
+ * See §stable-tab-keys in PRECEDENT.md.
+ *
+ * @param {{ next: number, tabs: Array<{ key: string, title: string }> }} state - Current tab strip state; not mutated.
+ * @param {string} key - Key of the tab to close, e.g. `"t2"`. An unknown key closes nothing.
+ * @returns {{ next: number, tabs: Array<{ key: string, title: string }> }} A new state without that tab. `next` is
+ *   unchanged, so a closed key is never reused.
+ */
 export function closeTab(state, key) {
   return { ...state, tabs: state.tabs.filter((tab) => tab.key !== key) };
 }
