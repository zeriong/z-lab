1: #!/usr/bin/env bash
2: # 전체 src JavaScript 파일의 단일 사용자 규칙과 확정된 npm 검사를 실행한다.
3: # exit 0: 통과, 1: 규칙/검사 실패, 2: 인자/검사 환경 오류.
4: set -euo pipefail
5: MODE=full
6: for arg in "$@"; do
7:   case "$arg" in
8:     --mode=full|--mode=refs-only) MODE="${arg#--mode=}" ;;
9:     --rule=no-literal-todo) ;;
10:     -h|--help) printf '%s\n' 'Usage: review-gate.sh [--mode=full|--mode=refs-only] [--rule=no-literal-todo]'; exit 0 ;;
11:     *) printf 'Invalid argument: %s\n' "$arg" >&2; exit 2 ;;
12:   esac
13: done
14: ROOT="$(cd "$(dirname "$0")/../.." && pwd)" || exit 2
15: cd "$ROOT" || exit 2
16: command -v python3 >/dev/null || exit 2
17: status=0
18: python3 - <<'CHECK' || status=$?
19: from pathlib import Path
20: import os
21: import sys
22: 
23: def fail(error):
24:     raise error
25: 
26: try:
27:     root = Path('src')
28:     if not root.is_dir():
29:         raise OSError('src directory missing')
30:     violations = []
31:     for directory, dirs, files in os.walk(root, onerror=fail, followlinks=False):
32:         dirs.sort()
33:         for name in dirs:
34:             if (Path(directory) / name).is_symlink():
35:                 raise OSError(f'cannot safely inspect symlink directory: {Path(directory) / name}')
36:         for name in sorted(files):
37:             path = Path(directory) / name
38:             if path.suffix not in {'.js', '.jsx', '.mjs', '.cjs'}:
39:                 continue
40:             data = path.read_bytes()
41:             for line, value in enumerate(data.split(b'\n'), 1):
42:                 if b'TODO' in value:
43:                     violations.append(f'{path}:{line}: P2 no-literal-todo')
44:     for violation in violations:
45:         print(violation)
46:     print('no-literal-todo: ' + ('FAIL' if violations else 'PASS'))
47:     sys.exit(1 if violations else 0)
48: except OSError as error:
49:     print(f'Inspection error: {error}', file=sys.stderr)
50:     sys.exit(2)
51: CHECK
52: [[ "$status" -le 1 ]] || exit 2
53: if [[ "$MODE" == full ]]; then
54:   command -v npm >/dev/null || exit 2
55:   for check in lint typecheck; do
56:     if npm run "$check"; then
57:       printf '%s: PASS\n' "$check"
58:     else
59:       printf '%s: FAIL\n' "$check"
60:       status=1
61:     fi
62:   done
63: fi
64: printf 'Gate exit: %s\n' "$status"
65: exit "$status"
