{
  "name": "slingshot-bird",
  "version": "1.0.0",
  "private": true,
  "description": "슬링샷 버드 - Matter.js + Canvas 2D 물리 슬링샷 게임",
  "type": "module",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "matter-js": "0.20.0"
  },
  "devDependencies": {
    "@playwright/test": "1.48.2",
    "@types/matter-js": "0.19.7",
    "@types/node": "20.17.6",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vitest": "2.1.8"
  }
}
