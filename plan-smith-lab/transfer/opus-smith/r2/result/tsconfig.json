{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "allowJs": false,
    "noEmit": true
  },
  "include": ["src", "scripts", "tests"],
  "references": [{ "path": "./tsconfig.app.json" }]
}
